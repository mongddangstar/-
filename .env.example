# DART OpenAPI 인증키 (https://opendart.fss.or.kr 발급, 무료)
# 실제 키는 이 파일이 아니라 gitignore 되는 .env 또는 환경 Secret으로 주입한다.
# 사용법:  cp .env.example .env  후 실제 키 입력 (또는 환경변수로 DART_API_KEY 설정)
DART_API_KEY=

# ── 전사(全社) 사용 안내 ─────────────────────────────────────────────
# 1) 키는 저장소에 커밋하지 말 것. (.env 는 .gitignore 처리됨)
# 2) 여러 세션/프로젝트에서 영구 사용하려면 Claude Code '환경 설정'의
#    Secrets/환경변수에 DART_API_KEY 를 등록한다(원격 컨테이너는 세션 종료 시 초기화됨).
# 3) DART OpenAPI(opendart.fss.or.kr)는 환경의 egress(네트워크) 허용목록에
#    포함돼야 호출된다. 미포함 시 프록시가 403으로 차단한다.
